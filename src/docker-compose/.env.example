# docker-compose 部署示例配置：复制为 .env 后按需修改
#   cp .env.example .env
# 注意：.env 会被容器内「认证配置重载」写入真实 LDAP/OIDC/钉钉密钥，切勿提交到 git
# （本仓库已通过 .gitignore 排除 .env）
#
# 以下三个变量为必填：留空时 docker compose 会直接报错拒绝启动。
# 密码请使用 URL 安全字符（或做 percent-encoding），因为要拼进 DATABASE_URL / CACHE_URL。
# 生成随机密码/密钥：
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

NGINX_PORT=9123
# MySQL / goInception 默认只绑定 127.0.0.1；如需改宿主端口，改这两个变量
MYSQL_HOST_PORT=3306
GOINCEPTION_HOST_PORT=4000

MYSQL_ROOT_PASSWORD=
REDIS_PASSWORD=
SECRET_KEY=

# https://django-environ.readthedocs.io/en/latest/quickstart.html#usage
# https://docs.djangoproject.com/zh-hans/4.1/ref/settings/
DEBUG=false
# 生产部署改为实际域名/IP；不要使用 *（防 Host 头攻击）
ALLOWED_HOSTS=127.0.0.1,localhost
# DATABASE_URL / CACHE_URL 由 docker-compose 根据上面的密码变量生成；
# 仅当不使用 docker-compose（例如直接 runserver 连本机服务）时才需要手工填写：
#DATABASE_URL=mysql://root:CHANGE_ME@127.0.0.1:3306/archery
#CACHE_URL=redis://:CHANGE_ME@127.0.0.1:6379/0

# https://docs.djangoproject.com/en/4.0/ref/settings/#csrf-trusted-origins
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:9123

# HTTPS 部署时置 true（会话/CSRF Cookie 只走 HTTPS）
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
# 全站强制 HTTPS（通常由 nginx 301 处理；启用时确认代理头已正确设置）
SECURE_SSL_REDIRECT=false
# HSTS 默认关闭；确认全站 HTTPS 后可设为 31536000
SECURE_HSTS_SECONDS=0
# 位于可信反向代理（nginx）之后时保持 true；直接暴露 Django 端口时置 false
TRUST_X_FORWARDED_PROTO=true

# https://django-auth-ldap.readthedocs.io/en/latest/
#ENABLE_LDAP=false
#AUTH_LDAP_ALWAYS_UPDATE_USER=true
#AUTH_LDAP_USER_ATTR_MAP=username=cn,display=displayname,email=email

# https://django-q.readthedocs.io/en/latest/configure.html#
Q_CLUSTER_WORKERS=4
Q_CLUSTER_TIMEOUT=60
Q_CLUSTER_SYNC=false
# AI 优化/诊断任务：生产由 qcluster 持久执行
AI_TASK_QUEUE=true

# 在网站标题及登录页面追加此内容, 可用于多dbshield实例的区分。DBShield后台也有相同配置，如都做了配置，以后台配置为准
CUSTOM_TITLE_SUFFIX=""
